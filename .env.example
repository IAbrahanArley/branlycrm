APP_PORT=8088
POSTGRES_DB=branlycrm
POSTGRES_USER=branlycrm
POSTGRES_PASSWORD=substitua-por-uma-senha-local

CONTROL_RUNTIME_PASSWORD=substitua-por-senha-exclusiva
CONTROL_MIGRATION_PASSWORD=substitua-por-outra-senha
TENANT_PROVISIONER_PASSWORD=substitua-por-outra-senha
PROVISIONING_WORKER_PASSWORD=substitua-por-outra-senha
# Only the platform command (docker compose --profile tools run --rm platform ...).
PLATFORM_OPERATOR_PASSWORD=substitua-por-outra-senha

# E-mail (ADR-021). Locally, MAIL_PROVIDER=local writes messages to files and never sends them.
# In production: MAIL_PROVIDER=resend, an HTTPS APP_PUBLIC_ORIGIN and the real key only in .env.
APP_PUBLIC_ORIGIN=http://localhost:8088
MAIL_PROVIDER=local
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Branly CRM
RESEND_API_KEY=

# Second factor (CRM-016): base64 of 32 random bytes, only for the API. Generate your own,
# for example: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=
