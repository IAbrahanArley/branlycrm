APP_PORT=8088
POSTGRES_DB=branlycrm
POSTGRES_USER=branlycrm
POSTGRES_PASSWORD=substitua-por-uma-senha-local

CONTROL_RUNTIME_PASSWORD=substitua-por-senha-exclusiva
CONTROL_MIGRATION_PASSWORD=substitua-por-outra-senha
TENANT_PROVISIONER_PASSWORD=substitua-por-outra-senha
PROVISIONING_WORKER_PASSWORD=substitua-por-outra-senha
# Only the platform command (docker compose --profile tools run --rm platform ...).
PLATFORM_OPERATOR_PASSWORD=substitua-por-outra-senha
# WhatsApp worker (ADR-036): central channel registry only.
WHATSAPP_WORKER_PASSWORD=substitua-por-outra-senha

# E-mail (ADR-021). Locally, MAIL_PROVIDER=local writes messages to files and never sends them.
# In production: MAIL_PROVIDER=resend, an HTTPS APP_PUBLIC_ORIGIN and the real key only in .env.
APP_PUBLIC_ORIGIN=http://localhost:8088
MAIL_PROVIDER=local
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Branly CRM
RESEND_API_KEY=

# Second factor (CRM-016): base64 of 32 random bytes, only for the API. Generate your own,
# for example: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=

# WhatsApp secrets (CRM-082a, CRM-081b): files in folders ignored by Git, never values here.
#   .whatsapp-meta/app-secret       -> the Meta app secret (Settings > Basic); API and worker
#   .whatsapp-webhook/verify-token  -> a random text of 16+ characters, also typed in the Meta
#                                      webhook settings; API only
# Without them the webhook and the connection answer 503.
# WHATSAPP_META_DIR=./.whatsapp-meta
# WHATSAPP_WEBHOOK_DIR=./.whatsapp-webhook

# WhatsApp connection (CRM-081b): the Meta app id (Settings > Basic). Not a secret.
WHATSAPP_APP_ID=

# WhatsApp media (CRM-084b1): private bucket in OCI Object Storage, São Paulo, through its S3 API.
# The endpoint is https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
# The access key (an OCI Customer Secret Key) goes in two files, never here:
#   .whatsapp-storage/access-key-id and .whatsapp-storage/secret-access-key
WHATSAPP_MEDIA_BUCKET=
WHATSAPP_MEDIA_ENDPOINT=
# WHATSAPP_MEDIA_REGION=sa-saopaulo-1
# WHATSAPP_STORAGE_DIR=./.whatsapp-storage
